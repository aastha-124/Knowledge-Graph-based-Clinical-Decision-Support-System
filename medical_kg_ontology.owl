    <rdfs:comment>Simple ontology describing the classes and relationships of the medical KG built in Neo4j.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/medical-kg#RiskFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>RiskFactor</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/medical-kg#MedicalEntity"/>
    <rdfs:comment>Something that raises the chance of a disease</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/medical-kg#DigestiveDisease">
